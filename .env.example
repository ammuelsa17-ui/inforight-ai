# Environment Variable Template for InfoRight AI

# Server-Side Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Controlled Server Failure Simulation Toggle (true in Preview, false in Production)
ENABLE_DEMO_FAILURE=false

# BHASHINI Multilingual Translation Service (Optional Server-Side Credentials)
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
